        "NSMicrophoneUsageDescription": "Necesitamos enviarte una alerta de audio para que no pierdas ni un sola sola oferta de servicio solicitada por nuestros clientes",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location",
          "fetch",
          "audio"
        ]
      },
      "config": {
        "googleMapsApiKey": "AIzaSyA5Q7U5qVt_NbzZ5z5vBJv7ECTsGZ9-chM"
      },
      "sounds": [
        "./assets/sounds/pedido.wav",
        "./assets/sounds/carrera.wav"
